# 大模型（用于意图理解与对话；搜索 API 的 Key 单独配置）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 通用网页搜索：auto=有 Key 用博查、无 Key 用明确标注的演示数据；bocha=仅用真实接口；demo=仅用演示数据
SEARCH_SOURCE=auto
BOCHA_API_KEY=
SEARCH_TIMEOUT=20

# SQLite 内部存储（相对项目根目录）；交付文件默认写入 exports/results.csv 和 exports/analysis.csv
SEARCH_DB_PATH=data/results.db
# SEARCH_WORKSPACE_ROOT=

AGENT_RECURSION_LIMIT=25
# 也可以不复制 .env，直接用该变量指定已有 env 文件
# AGENT_ENV_FILE=C:\path\to\study2026.env
